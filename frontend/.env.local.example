# Resolution Lab Frontend - Environment Variables

# Backend API URL (FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================
# Google AI API Keys
# ===================

# Streaming API Key (for message generation via Vercel AI SDK)
# Use a dedicated key to keep message generation costs separate
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_STREAMING_API_KEY=your_streaming_api_key_here

# Fallback key (used if GOOGLE_STREAMING_API_KEY is not set)
# GOOGLE_GENERATIVE_AI_API_KEY=your_fallback_api_key_here

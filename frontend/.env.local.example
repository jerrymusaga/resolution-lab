# Resolution Lab Frontend - Environment Variables
# Copy this to .env.local and fill in your values

# ===================
# Backend API URL
# ===================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================
# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===================
# Google AI API Keys
# Get your key from: https://aistudio.google.com/apikey
# ===================

# Streaming API Key (for message generation via Vercel AI SDK)
GOOGLE_STREAMING_API_KEY=your-google-api-key-here

# Fallback key (used if GOOGLE_STREAMING_API_KEY is not set)
# GOOGLE_GENERATIVE_AI_API_KEY=your-fallback-api-key-here
